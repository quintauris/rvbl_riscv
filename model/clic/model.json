{
    "$schema": "../../../core/meta/peripheral.schema.json",
    "name": "clic",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": {
        "content": "Core-Local Interrrupt Controller (CLIC) Device Model.\nSee https://riscv.atlassian.net/wiki/spaces/HOME/pages/16154646/Fast+Interrupts+TG."
    },
    "addressables": [
        {
            "name": "control_status_registers",
            "offset": "0",
            "size": "64K",
            "default": {
                "register": {
                    "class": "control_status"
                }
            },
            "registers": {
                "mtvt": {
                    "offset": "0x307"
                }
            }
        },
        {
            "name": "registers",
            "offset": "0",
            "size": "64M",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": {
                "cfg": {
                    "offset": "0x0000",
                    "width": 8,
                    "fields": {
                        "nvbits": {
                            "length": 1,
                            "position": 0
                        },
                        "nlbits": {
                            "length": 4,
                            "position": 1
                        },
                        "nmbits": {
                            "length": 2,
                            "position": 5
                        }
                    }
                },
                "info": {
                    "offset": "0x0004",
                    "width": 32,
                    "fields": {
                        "num_interrupt": {
                            "length": 13,
                            "position": 0
                        },
                        "clicintctlbits": {
                            "length": 4,
                            "position": 21
                        },
                        "version_implementation": {
                            "length": 4,
                            "position": 13
                        },
                        "version_architecture": {
                            "length": 4,
                            "position": 17
                        },
                        "clicintbits": {
                            "length": 4,
                            "position": 21
                        }
                    }
                },
                "_int": {
                    "offset": "0x1000",
                    "width": 32,
                    "indexing": {
                        "dimensions": {
                            "dim0": {
                                "ranges": [
                                    [
                                        "0",
                                        "$INTERRUPT_INPUTS - 1"
                                    ]
                                ],
                                "stride": "4"
                            }
                        }
                    },
                    "fields": {
                        "ip": {
                            "length": 8,
                            "position": 0
                        },
                        "ie": {
                            "length": 8,
                            "position": 8
                        },
                        "attr_shv": {
                            "length": 1,
                            "position": 16
                        },
                        "attr_trig": {
                            "length": 2,
                            "position": 17,
                            "values": {
                                "positive_level": {
                                    "value": "0"
                                },
                                "positive_edge": {
                                    "value": "1"
                                },
                                "negative_level": {
                                    "value": "2"
                                },
                                "negative_edge": {
                                    "value": "3"
                                }
                            }
                        },
                        "attr_mode": {
                            "length": 2,
                            "position": 19,
                            "values": {
                                "machine": {
                                    "value": "3"
                                },
                                "supervisor": {
                                    "value": "1"
                                },
                                "user": {
                                    "value": "0"
                                }
                            }
                        },
                        "ctl": {
                            "length": 8,
                            "position": 24
                        }
                    }
                }
            }
        }
    ],
    "parameters": [
        {
            "name": "interrupt_inputs",
            "stage": "compile",
            "class": "uint32",
            "value": "$INTERRUPT_INPUTS"
        }
    ]
}
