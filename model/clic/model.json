{
    "$schema": "../../../core/meta/peripheral.schema.json",
    "name": "clic",
    "instance": "$INSTANCE",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": {
        "content": "Core-Local Interrrupt Controller (CLIC) Device Model.\nSee https://riscv.atlassian.net/wiki/spaces/HOME/pages/16154646/Fast+Interrupts+TG."
    },
    "addressables": [
        {
            "name": "control_status_registers",
            "base": "0",
            "size": "64K",
            "default_register_class": "control_status",
            "registers": [
                {
                    "name": "mtvt",
                    "offset": "0x307"
                }
            ]
        },
        {
            "name": "registers",
            "base": "$BASE",
            "size": "64M",
            "default_register_class": "memory_mapped",
            "registers": [
                {
                    "name": "cfg",
                    "offset": "0x0000",
                    "width": 8,
                    "fields": [
                        {
                            "name": "nvbits",
                            "length": 1,
                            "position": 0
                        },
                        {
                            "name": "nlbits",
                            "length": 4,
                            "position": 1
                        },
                        {
                            "name": "nmbits",
                            "length": 2,
                            "position": 5
                        }
                    ]
                },
                {
                    "name": "info",
                    "offset": "0x0004",
                    "width": 32,
                    "fields": [
                        {
                            "name": "num_interrupt",
                            "length": 13,
                            "position": 0
                        },
                        {
                            "name": "clicintctlbits",
                            "length": 4,
                            "position": 21
                        },
                        {
                            "name": "version_implementation",
                            "length": 4,
                            "position": 13
                        },
                        {
                            "name": "version_architecture",
                            "length": 4,
                            "position": 17
                        },
                        {
                            "name": "clicintbits",
                            "length": 4,
                            "position": 21
                        }
                    ]
                },
                {
                    "name": "_int",
                    "offset": "0x1000",
                    "width": 32,
                    "indexing": {
                        "lower_bound": "0",
                        "upper_bound": "$INTERRUPT_INPUTS - 1",
                        "stride": "4"
                    },
                    "fields": [
                        {
                            "name": "ip",
                            "length": 8,
                            "position": 0
                        },
                        {
                            "name": "ie",
                            "length": 8,
                            "position": 8
                        },
                        {
                            "name": "attr_shv",
                            "length": 1,
                            "position": 16
                        },
                        {
                            "name": "attr_trig",
                            "length": 2,
                            "position": 17,
                            "values": [
                                {
                                    "name": "positive_level",
                                    "value": "0"
                                },
                                {
                                    "name": "positive_edge",
                                    "value": "1"
                                },
                                {
                                    "name": "negative_level",
                                    "value": "2"
                                },
                                {
                                    "name": "negative_edge",
                                    "value": "3"
                                }
                            ]
                        },
                        {
                            "name": "attr_mode",
                            "length": 2,
                            "position": 19,
                            "values": [
                                {
                                    "name": "machine",
                                    "value": "3"
                                },
                                {
                                    "name": "supervisor",
                                    "value": "1"
                                },
                                {
                                    "name": "user",
                                    "value": "0"
                                }
                            ]
                        },
                        {
                            "name": "ctl",
                            "length": 8,
                            "position": 24
                        }
                    ]
                }
            ]
        }
    ],
    "parameters": [
        {
            "name": "interrupt_inputs",
            "stage": "compile",
            "class": "uint32",
            "value": "$INTERRUPT_INPUTS"
        }
    ]
}
