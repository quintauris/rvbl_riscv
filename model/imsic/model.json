{
    "$schema": "../../../core/meta/peripheral.schema.json",
    "name": "imsic",
    "instance": "$INSTANCE",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": {
        "content": "Incoming Message-Signaled Interrrupt Controller (IMSIC) Device Model.\nSee https://riscv.atlassian.net/wiki/spaces/HOME/pages/806289428/RISC-V+Advanced+Interrupt+Architecture."
    },
    "addressables": [
        {
            "name": "machine_files",
            "base": "$MACHINE_FILES_BASE",
            "size": "$HART_COUNT * $PAGE_SIZE",
            "default_register_class": "memory_mapped",
            "registers": [
                {
                    "name": "mseteipnum_le",
                    "width": 32,
                    "offset": "0x0",
                    "indexing": {
                        "upper_bound": "$HART_COUNT",
                        "stride": "$PAGE_SIZE"
                    }
                },
                {
                    "name": "mseteipnum_be",
                    "width": 32,
                    "offset": "0x0004",
                    "indexing": {
                        "upper_bound": "$HART_COUNT",
                        "stride": "$PAGE_SIZE"
                    }
                }
            ]
        },
        {
            "name": "supervisor_files",
            "base": "$SUPERVISOR_FILES_BASE",
            "size": "$HART_COUNT * $PAGE_SIZE",
            "default_register_class": "memory_mapped",
            "registers": [
                {
                    "name": "sseteipnum_le",
                    "width": 32,
                    "offset": "0x0",
                    "indexing": {
                        "upper_bound": "$HART_COUNT",
                        "stride": "$PAGE_SIZE"
                    }
                },
                {
                    "name": "sseteipnum_be",
                    "width": 32,
                    "offset": "0x0004",
                    "indexing": {
                        "upper_bound": "$HART_COUNT",
                        "stride": "$PAGE_SIZE"
                    }
                }
            ]
        }
    ],
    "parameters": [
        {
            "name": "page_size",
            "stage": "compile",
            "class": "uint32",
            "value": "$PAGE_SIZE"
        }
    ]
}
