{
    "$schema": "../../../core/meta/peripheral.schema.json",
    "name": "aclint",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": {
        "content": "Advanced Core-Local Interrruptor (ACLINT) Device Model.\nSee https://github.com/riscvarchive/riscv-aclint."
    },
    "addressables": [
        {
            "name": "mtimer_time",
            "base": "$MTIMER_TIME_OFFSET",
            "size": "8",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": [
                {
                    "name": "mtime",
                    "offset": "0x0",
                    "width": 64
                }
            ]
        },
        {
            "name": "mtimer_compare",
            "base": "$MTIMER_COMPARE_OFFSET",
            "size": "8 * $HART_COUNT",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": [
                {
                    "name": "mtimecmp",
                    "offset": "0x0",
                    "width": 64,
                    "indexing": {
                        "dimensions": [
                            {
                                "name": "dim0",
                                "ranges": [
                                    [
                                        "0",
                                        "$HART_COUNT - 1"
                                    ]
                                ]
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "machine_interrupt",
            "base": "$MSWI_MSIP_OFFSET",
            "size": "4 * ${HART_COUNT}",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": [
                {
                    "name": "msip",
                    "offset": "0x0",
                    "width": 32,
                    "indexing": {
                        "dimensions": [
                            {
                                "name": "dim0",
                                "ranges": [
                                    [
                                        "0",
                                        "$HART_COUNT - 1"
                                    ]
                                ]
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "supervisor_interrupt",
            "base": "$SSWI_SETSSIP_OFFSET",
            "size": "4 * ${HART_COUNT}",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": [
                {
                    "name": "setssip",
                    "offset": "0x0",
                    "width": 32,
                    "indexing": {
                        "dimensions": [
                            {
                                "name": "dim0",
                                "ranges": [
                                    [
                                        "0",
                                        "$HART_COUNT - 1"
                                    ]
                                ]
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "parameters": [
        {
            "name": "hart_count",
            "stage": "compile",
            "class": "uint32",
            "value": "$HART_COUNT"
        }
    ]
}
