{
    "$schema": "../../../core/meta/peripheral.schema.json",
    "name": "aclint",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": {
        "content": "Advanced Core-Local Interrruptor (ACLINT) Device Model.\nSee https://github.com/riscvarchive/riscv-aclint."
    },
    "addressables": {
        "mtimer_time": {
            "offset": "$MTIMER_TIME_OFFSET",
            "size": "8",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": {
                "mtime": {
                    "offset": "0x0",
                    "width": 64
                }
            }
        },
        "mtimer_compare": {
            "offset": "$MTIMER_COMPARE_OFFSET",
            "size": "8 * $HART_COUNT",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": {
                "mtimecmp": {
                    "offset": "0x0",
                    "width": 64,
                    "indexing": {
                        "dimensions": {
                            "dim0": {
                                "ranges": [
                                    [
                                        "0",
                                        "$HART_COUNT - 1"
                                    ]
                                ]
                            }
                        }
                    }
                }
            }
        },
        "machine_interrupt": {
            "offset": "$MSWI_MSIP_OFFSET",
            "size": "4 * ${HART_COUNT}",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": {
                "msip": {
                    "offset": "0x0",
                    "width": 32,
                    "indexing": {
                        "dimensions": {
                            "dim0": {
                                "ranges": [
                                    [
                                        "0",
                                        "$HART_COUNT - 1"
                                    ]
                                ]
                            }
                        }
                    }
                }
            }
        },
        "supervisor_interrupt": {
            "offset": "$SSWI_SETSSIP_OFFSET",
            "size": "4 * ${HART_COUNT}",
            "default": {
                "register": {
                    "class": "memory_mapped"
                }
            },
            "registers": {
                "setssip": {
                    "offset": "0x0",
                    "width": 32,
                    "indexing": {
                        "dimensions": {
                            "dim0": {
                                "ranges": [
                                    [
                                        "0",
                                        "$HART_COUNT - 1"
                                    ]
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    "parameters": {
        "hart_count": {
            "stage": "compile",
            "class": "uint32",
            "value": "$HART_COUNT"
        }
    }
}
