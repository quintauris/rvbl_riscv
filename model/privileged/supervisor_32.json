{
    "$schema": "../../../core/meta/addressable.schema.json",
    "name": "supervisor_32",
    "$comment": "Copyright 2026 Quintauris GmbH. Licensed under the Apache License, Version 2.0 (the \"License\", https://www.apache.org/licenses/LICENSE-2.0)",
    "description": {
        "content": "Models RISC-V 32-bit Supervisor (S) mode CSRs."
    },
    "size": "64K",
    "offset": "0",
    "default": {
        "register": {
            "class": "control_status"
        }
    },
    "registers": {
        "sstatus": {
            "width": 32,
            "offset": "0x100",
            "fields": {
                "sie": {
                    "position": 1,
                    "length": 1
                },
                "spie": {
                    "position": 5,
                    "length": 1
                },
                "ube": {
                    "position": 6,
                    "length": 1
                },
                "spp": {
                    "position": 8,
                    "length": 1
                },
                "vs": {
                    "position": 9,
                    "length": 2
                },
                "fs": {
                    "position": 13,
                    "length": 2
                },
                "xs": {
                    "position": 15,
                    "length": 2
                },
                "sum": {
                    "position": 18,
                    "length": 1
                },
                "mxr": {
                    "position": 19,
                    "length": 1
                },
                "sdt": {
                    "position": 24,
                    "length": 1
                },
                "sd": {
                    "position": 31,
                    "length": 1
                }
            }
        },
        "stimecmp": {
            "width": 32,
            "offset": "0x14D"
        },
        "stimecmph": {
            "width": 32,
            "offset": "0x15D"
        }
    }
}
